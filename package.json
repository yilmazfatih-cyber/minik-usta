{
  "name": "minik-usta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && npm run assets:check && npm run build:verify",
    "build:verify": "vite build && node tools/verify-dist.ts",
    "build:harness": "vite build --mode harness",
    "assets": "node tools/assets.ts",
    "assets:check": "node tools/assets.ts --check",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "node tools/rule-coverage.ts --phase 2",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.core.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "levels:validate": "node tools/validate-levels.ts",
    "levels:solve": "node tools/solve.ts",
    "levels:check": "node tools/solve.ts --check",
    "screens": "npm run build:harness && node tools/screens.ts",
    "perf": "npm run build:harness && node tools/perf.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:rules"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
